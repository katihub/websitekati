# =============================================================================
#  LA VITRINE NOWTECH CENTER — SES VARIABLES
# =============================================================================
#
#  En production, ces valeurs se collent dans Vercel (Settings → Environment
#  Variables) : le générateur du backend les écrit toutes dans
#  `livraison/sortie/3-vitrine-vercel.env`. En développement, copiez ce fichier
#  en `.env.local` et remplissez-le.
#
#  Les variables `NEXT_PUBLIC_…` sont figées au moment de la construction :
#  après les avoir changées dans Vercel, redéployez.
#
#  Voir documentation/tutoriel-vitrine.pdf.
# =============================================================================

# L'adresse de l'API, sans barre finale (ex. https://api.nowtechcenter.com).
NEXT_PUBLIC_API_URL=

# L'adresse de Supabase et sa clé publique (« anon ») : les comptes clients.
# Jamais la clé « service_role » ici : tout ce qui commence par NEXT_PUBLIC_
# est envoyé aux navigateurs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Le secret partagé avec l'API (sa variable du même nom). Il ouvre la route
# par laquelle l'API dit à la vitrine qu'un prix ou un produit a changé, et il
# fait reconnaître le serveur de la vitrine par l'API, qui ne le bride pas.
REVALIDATION_SECRET=

# Facultatif : d'autres hôtes d'images à autoriser, séparés par des virgules.
# Les hôtes des photos sont normalement demandés à l'API à la construction.
IMAGES_ORIGINES=

# Développement seulement : connexion sans Supabase, contre un backend local
# démarré sans Supabase. Sans effet sur un déploiement de production.
# NEXT_PUBLIC_CONNEXION_LOCALE=1

# Assistant de rédaction des fiches produit (serveur uniquement).
# Ne préfixez jamais la clé avec NEXT_PUBLIC_ : elle ne doit pas atteindre le navigateur.
OPENAI_API_KEY=
# Facultatif. Le modèle par défaut est gpt-6-astra.
OPENAI_PRODUCT_COPY_MODEL=gpt-6-astra
